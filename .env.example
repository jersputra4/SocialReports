# =============================================================================
# Sistem Pelaporan Konten Media Sosial - konfigurasi lokal
# Salin ke `.env` lalu sesuaikan. JANGAN commit file `.env`.
# Semua secret di bawah hanya untuk pengembangan lokal.
# =============================================================================

NODE_ENV=development
APP_NAME="Sistem Pelaporan Konten"
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------ database
POSTGRES_USER=srs
POSTGRES_PASSWORD=srs_local_password
POSTGRES_DB=social_report
POSTGRES_PORT=55432
DATABASE_URL=postgresql://srs:srs_local_password@localhost:55432/social_report?schema=public

# --------------------------------------------------------------------- redis
REDIS_PASSWORD=redis_local_password
REDIS_URL=redis://:redis_local_password@localhost:56379

# ------------------------------------------------------------- object storage
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=social-report
S3_ACCESS_KEY=srs_minio_admin
S3_SECRET_KEY=srs_minio_password
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
# Umur signed URL (BRD 4.5: <= 120 detik)
SIGNED_URL_TTL_SECONDS=120

# ------------------------------------------------------------------- session
# Ganti dengan nilai acak 64 byte di lingkungan nyata (openssl rand -hex 64).
SESSION_SECRET=dev_only_session_secret_change_me_0000000000000000000000000000
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_IDLE_MINUTES_USER=30
SESSION_IDLE_MINUTES_ADMIN=15
SESSION_ABSOLUTE_HOURS_USER=12
SESSION_ABSOLUTE_HOURS_ADMIN=8
STEP_UP_MFA_WINDOW_MINUTES=10

# ----------------------------------------------------------- metadata fetcher
FETCHER_URL=http://localhost:4001
FETCHER_SERVICE_TOKEN=dev_only_fetcher_service_token_change_me

# -------------------------------------------------------------- notifikasi n8n
N8N_WEBHOOK_URL=http://localhost:4002/webhook/report-events
N8N_HMAC_SECRET=dev_only_n8n_hmac_secret_change_me
N8N_TIMESTAMP_TOLERANCE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=8

# ------------------------------------------------------------ payment gateway
# Driver `mock` menjalankan gateway simulasi in-process dengan halaman checkout,
# webhook bertanda tangan HMAC, dan endpoint status server-to-server.
# Ganti ke `midtrans` / `xendit` lalu isi kredensial untuk gateway nyata.
PAYMENT_DRIVER=mock
PAYMENT_PROVIDER_NAME=mockpay
PAYMENT_WEBHOOK_SECRET=dev_only_payment_webhook_secret_change_me
PAYMENT_EXPIRY_HOURS=24
PAYMENT_RETRY_WINDOW_DAYS=7

# --------------------------------------------------------------------- email
# Driver `mailbox` menyimpan email ke database dan menampilkannya di /dev/mailbox.
# Ganti ke `smtp` lalu isi SMTP_* untuk penyedia email transaksional.
MAIL_DRIVER=mailbox
MAIL_FROM="Sistem Pelaporan Konten <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------ keamanan
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH_USER=10
PASSWORD_MIN_LENGTH_ADMIN=12
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_MINUTES=15
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_10_MINUTES=3
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------- rate limit
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_HOUR=30

# ------------------------------------------------------------------- upload
MAX_UPLOAD_BYTES=5242880
MALWARE_SCANNER=mock
CLAMAV_HOST=
CLAMAV_PORT=3310

# --------------------------------------------------------- akun admin pertama
# Dipakai HANYA oleh `npm run cli:create-admin` di lingkungan pengembangan.
# Di production akun pertama dibuat lewat CLI sekali pakai dengan password acak.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
