{
  "name": "social-report-backend",
  "version": "1.1.0",
  "private": true,
  "description": "API, worker, dan CLI Sistem Pelaporan Konten Media Sosial (BRD/SRS v1.1)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "worker:dev": "ts-node -r tsconfig-paths/register src/worker/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "cli:create-admin": "ts-node cli/create-admin.ts",
    "cli:seed-uu-ite": "ts-node cli/seed-uu-ite.ts",
    "cli:verify-audit": "ts-node cli/verify-audit-chain.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && jest",
    "lint": "eslint \"{src,cli,prisma}/**/*.ts\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "4.1.1",
    "@prisma/client": "5.20.0",
    "argon2": "0.41.1",
    "bullmq": "5.15.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.15",
    "pdfmake": "0.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.22",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/multer": "1.4.12",
    "@types/node": "22.7.4",
    "@types/nodemailer": "6.4.16",
    "@types/pdfmake": "0.2.9",
    "jest": "29.7.0",
    "prisma": "5.20.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testRegex": ".*\\.spec\\.ts$"
  }
}
