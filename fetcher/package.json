{
  "name": "metadata-fetcher",
  "version": "1.1.0",
  "private": true,
  "description": "Pengambil metadata URL target yang terisolasi (BRD/SRS v1.1 §4.2)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "29.5.13",
    "@types/node": "22.7.4",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testRegex": ".*\\.spec\\.ts$"
  }
}
